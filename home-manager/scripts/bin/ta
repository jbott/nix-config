#!/usr/bin/env bash
# tmux attach or create session
# Usage: ta [session_name]
# If no session name provided, defaults to "main"

session_name="${1:-main}"
# exec so bash is replaced by tmux instead of waiting on it as a child.
# Without exec, a non-interactive bash sits between zsh and the tmux client;
# when the client suspends (e.g. prefix C-z) it can't hand back a usable shell
# and the terminal hangs with no output. With exec, the client's parent is the
# interactive zsh, so suspend lands you cleanly at a prompt (resume with `fg`).
exec tmux -u new-session -A -s "$session_name"
