#!/usr/bin/env bash
set -euo pipefail

# Change to repository root if in a jj or git repository
root=$(jj workspace root 2>/dev/null) || root=$(git rev-parse --show-toplevel 2>/dev/null) || true
if [[ -n "${root:-}" ]]; then
    cd "$root"
fi

gen_codename() {
    local mods nouns
    mapfile -t mods < @modifiers@
    mapfile -t nouns < @nouns@
    printf '%s-%s\n' "${mods[RANDOM % ${#mods[@]}]}" "${nouns[RANDOM % ${#nouns[@]}]}"
}

worktree_name=
forwarded_args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -w=*|--worktree=*)
            worktree_name=${1#*=}
            [[ -z "$worktree_name" ]] && worktree_name=$(gen_codename)
            shift
            ;;
        -w|--worktree)
            if [[ $# -ge 2 && "$2" != -* ]]; then
                worktree_name=$2
                shift 2
            else
                worktree_name=$(gen_codename)
                shift
            fi
            ;;
        *)
            forwarded_args+=("$1")
            shift
            ;;
    esac
done

if [[ -n "$worktree_name" ]]; then
    forwarded_args+=(-w "$worktree_name")
fi

exec claude \
    --dangerously-skip-permissions \
    ${forwarded_args[@]+"${forwarded_args[@]}"}
